# --- Flask Core Configuration ---
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
# Generate a secure key in python: secrets.token_hex(16)
SECRET_KEY=dev_secret_key_change_in_production

# --- Database Connection (Member 1's Domain) ---
# Format: postgresql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql://postgres:password@localhost:5432/local_vendor

# --- M-Pesa Daraja API (Member 3's Domain) ---
# Get these from https://developer.safaricom.co.ke/
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_PASSKEY=your_passkey_here
MPESA_BUSINESS_SHORTCODE=174379
# This URL must be publicly accessible (use ngrok for local testing)
MPESA_CALLBACK_URL=https://your-render-app.onrender.com/api/payments/callback // Update with your Render app URL



// this file contains environment variables for the Flask backend application